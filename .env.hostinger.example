# ===== Restrack — Hostinger (production) environment template =====
# On the server: copy this file to ".env", then fill DB_PASSWORD and run:
#   php artisan key:generate
#   php artisan migrate --force --seed
#   php artisan config:cache route:cache view:cache
# NEVER commit the real .env (it holds live secrets).

APP_NAME=Restrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://restrack.sa
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- MySQL (Hostinger) ----
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_hostinger_db_name
DB_USERNAME=your_hostinger_db_user
DB_PASSWORD=__set_this_on_the_server__

# ---- Shared-hosting friendly drivers (no Redis/daemons) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ---- Mail (fill with Hostinger SMTP) ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@restrack.sa"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Payments (Paymob — KSA) ----
PAYMOB_BASE_URL=https://ksa.paymob.com
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC=
# Integration IDs of the enabled methods (card / mada / Apple Pay), comma-separated:
PAYMOB_INTEGRATION_IDS=
